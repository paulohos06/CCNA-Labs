LAB 07 Basic VLANs - initial lab
a) Switch Core
!
enable
configure terminal
hostname Core
no ip domain-lookup
!
interface vlan 1
ip address 10.1.1.254 255.255.255.0
no shutdown
exit
interface vlan 10
ip address 10.1.10.254 255.255.255.0
no shutdown
exit
interface vlan 20
ip address 10.1.20.254 255.255.255.0
no shutdown
exit
interface vlan 30
ip address 10.1.30.254 255.255.255.0
no shutdown
exit
interface vlan 100
ip address 10.1.100.254 255.255.255.0
no shutdown
exit
!
interface range g1/0/1-3
swithcport mode trunk
exit
interface g1/0/20
swithcport mode access
swithcport access vlan 100
end
!

b) Switch SW1
!
enable
configure terminal
hostname SW1
no ip domain-lookup
ip default gateway 10.1.1.254
!
interface f0/1
swithcport mode access
swithcport access vlan 10
no shutdown
exit
!
interface g0/1
swithcport mode trunk
exit
!
interface vlan 1
ip address 10.1.1.1 255.255.255.0
no shutdown
end
!

