LAB 08-VTP-Lab-1-initial
a) Switch SW1
!
enable
configure terminal
hostname SW1
no ip domain-lookup
!
interface g1/0/1
switchport mode trunk
exit
!
vtp domain ccna
vtp mode server
end
!

b) Switch SW2
!
enable
configure terminal
hostname SW2
no ip domain-lookup
!
interface range g1/0/1-2
switchport mode trunk
exit
!
vtp domain ccna
vtp mode transparent
end
!

c) Switch SW3
!
enable
configure terminal
hostname SW3
no ip domain-lookup
!
interface g1/01
switchport mode trunk
exit
!
vtp domain ccna
vtp mode client
end
!
